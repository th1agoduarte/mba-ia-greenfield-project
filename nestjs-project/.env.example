# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM='"StreamTube" <noreply@streamtube.com>'

# Object storage (MinIO locally, S3 in production) — read by src/config/storage.config.ts
# S3_ENDPOINT is used by the API/worker inside the Compose network.
# S3_PUBLIC_ENDPOINT is the host presigned URLs are signed for (what the client reaches).
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=streamtube-secret
S3_BUCKET=streamtube-videos
S3_PRESIGN_EXPIRES_SECONDS=3600
# Host ports published by compose.yaml (change if busy; keep S3_PUBLIC_ENDPOINT in sync)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Message queue (RabbitMQ) — read by src/config/messaging.config.ts
RABBITMQ_URL=amqp://streamtube:streamtube@rabbitmq:5672
RABBITMQ_USER=streamtube
RABBITMQ_PASSWORD=streamtube
# Prefix of the exchange/queues (<ns>, <ns>.processing, <ns>.processing.retry, <ns>.processing.dead)
RABBITMQ_NAMESPACE=videos
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Video processing (worker retries)
VIDEO_PROCESSING_RETRY_DELAY_MS=5000
VIDEO_PROCESSING_MAX_ATTEMPTS=3
